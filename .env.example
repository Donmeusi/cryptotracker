# Kopieren nach .env und Werte anpassen. .env ist gitignored.

# Oeffentliche URL der Instanz. Optional: Bleibt der Wert leer, ermittelt die
# App die Origin aus den Proxy-Headern (Host / X-Forwarded-Proto). Das ist der
# empfohlene Weg fuer Installationen, die auf beliebigen Hosts laufen.
# Fuer OIDC/SSO muss AUTH_URL gesetzt sein (Redirect-URI).
# Beispiel: AUTH_URL=https://crypto.example.de
AUTH_URL=

# Erzeugen mit: openssl rand -base64 32
# Ohne diesen Wert startet der Compose-Stack nicht (bewusst kein Default).
AUTH_SECRET=

# Kommagetrennte Liste der Admin-Adressen. Nur diese dürfen System-Updates,
# Datenbank-Konfiguration und die OIDC-Einstellungen sehen/ändern.
# Ohne Eintrag sind diese Endpunkte gesperrt.
ADMIN_EMAILS=

# Registrierung weiterer Konten erlauben. Nach dem ersten Konto ist die
# Registrierung standardmäßig geschlossen.
ALLOW_REGISTRATION=false

# Optional: OIDC / SSO (wird beim Start geladen)
# OIDC_ISSUER=https://auth.example.de
# OIDC_CLIENT_ID=cryptotracker
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_NAME=Single Sign-On

# Lokale Entwicklung (ohne Docker)
# DATABASE_URL="file:./cryptotracker.db"

# Optional: SMTP fuer Benachrichtigungen
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: OIDC (alternativ in der Oberflaeche konfigurierbar)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_NAME=
