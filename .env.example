# Kopieren nach .env und Werte anpassen. .env ist gitignored.

# Oeffentliche URL der Instanz.
AUTH_URL=http://localhost:3000

# Erzeugen mit: openssl rand -base64 32
# Ohne diesen Wert startet der Compose-Stack nicht (bewusst kein Default).
AUTH_SECRET=

# Lokale Entwicklung (ohne Docker)
# DATABASE_URL="file:./cryptotracker.db"

# Optional: SMTP fuer Benachrichtigungen
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: OIDC (alternativ in der Oberflaeche konfigurierbar)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_NAME=
